{
  "name": "@anoromi/local-ai-tools-protocol",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Effect Schema protocol definitions for local-ai-tools clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anoromi/local-ai-tools.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/Anoromi/local-ai-tools/issues"
  },
  "homepage": "https://github.com/Anoromi/local-ai-tools/tree/main/packages/protocol#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs"
    },
    "./encode": {
      "types": "./dist/encode.d.mts",
      "import": "./dist/encode.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown src/index.ts src/schema.ts src/encode.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "pack:dry": "npm pack --dry-run",
    "publish:npm": "npm publish --access public"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.45"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "effect": "4.0.0-beta.45",
    "tsdown": "^0.20.3",
    "typescript": "^6.0.3"
  }
}
