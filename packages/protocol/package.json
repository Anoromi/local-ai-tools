{
  "name": "@anoromi/kokoro-rocm-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect Schema protocol definitions for kokoro-rocm clients",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./encode": {
      "types": "./dist/encode.d.ts",
      "default": "./dist/encode.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts src/schema.ts src/encode.ts --target=node --outdir dist && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test test"
  },
  "dependencies": {
    "effect": "3.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
