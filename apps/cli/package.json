{
  "name": "@anoromi/local-ai-tools-cli",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/Bun CLI for local-ai-tools",
  "license": "MIT",
  "bin": {
    "local-ai-tools": "dist/local-ai-tools.js"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outfile dist/local-ai-tools.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "dev": "bun run src/main.ts"
  },
  "dependencies": {
    "@anoromi/local-ai-tools-protocol": "workspace:*",
    "@effect/platform-bun": "4.0.0-beta.45",
    "effect": "4.0.0-beta.45"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
