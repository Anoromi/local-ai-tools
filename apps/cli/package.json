{
  "name": "@anoromi/kokoro-rocm-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/Bun CLI for kokoro-rocm",
  "license": "MIT",
  "bin": {
    "kokoro-rocm": "dist/kokoro-rocm.js"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outfile dist/kokoro-rocm.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "dev": "bun run src/main.ts"
  },
  "dependencies": {
    "@anoromi/kokoro-rocm-protocol": "workspace:*",
    "@effect/platform-bun": "4.0.0-beta.45",
    "effect": "4.0.0-beta.45"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
